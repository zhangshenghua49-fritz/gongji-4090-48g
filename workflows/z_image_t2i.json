{
  "_note": "Z-Image-Turbo 文生图。CLIPLoader 这里故意选 type=stable_diffusion：ComfyUI 对 QWEN3_4B 编码器只在 flux/flux2 分支走 KleinTE，其余分支走 z_image TE（见 comfy/sd.py），所以这是加载 Z-Image 文本编码器的正确值。",
  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "z_image_turbo_nvfp4.safetensors",
      "weight_dtype": "default"
    }
  },
  "2": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen_3_4b_fp4_mixed.safetensors",
      "type": "stable_diffusion"
    }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "ae.safetensors"
    }
  },
  "4": {
    "class_type": "ModelSamplingAuraFlow",
    "inputs": {
      "model": ["1", 0],
      "shift": 3.0
    }
  },
  "5": {
    "class_type": "TextEncodeZImageOmni",
    "inputs": {
      "clip": ["2", 0],
      "prompt": "anime illustration, a girl in a navy sailor uniform standing on a school rooftop at sunset, long dark hair moving in the wind, warm rim light, detailed sky with cumulus clouds, soft bloom, high detail, clean lineart",
      "auto_resize_images": true
    }
  },
  "6": {
    "class_type": "ConditioningZeroOut",
    "inputs": {
      "conditioning": ["5", 0]
    }
  },
  "7": {
    "class_type": "EmptySD3LatentImage",
    "inputs": {
      "width": 1024,
      "height": 1024,
      "batch_size": 1
    }
  },
  "8": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["4", 0],
      "seed": 20261021,
      "steps": 8,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "positive": ["5", 0],
      "negative": ["6", 0],
      "latent_image": ["7", 0],
      "denoise": 1.0
    }
  },
  "9": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["8", 0],
      "vae": ["3", 0]
    }
  },
  "10": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["9", 0],
      "filename_prefix": "zimg/t2i"
    }
  }
}
