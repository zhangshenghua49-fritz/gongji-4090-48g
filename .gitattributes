# 换行符归一 —— 这个仓库的 shell 脚本必须在容器里用 LF 执行。
# Windows 上 core.autocrlf=true 会把 checkout 出来的一切变成 CRLF，
# 那会让 `bash script.sh` 报 "\r: command not found"，Dockerfile 里的
# RUN bash scripts/setup_env.sh 会直接失败。所以逐个类型钉死。
* text=auto eol=lf

*.sh    text eol=lf
*.py    text eol=lf
*.ps1   text eol=crlf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.md    text eol=lf
Dockerfile      text eol=lf
.dockerignore   text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf

# 二进制：不要做任何换行/编码处理
*.png  binary
*.jpg  binary
*.jpeg binary
*.mp4  binary
*.wav  binary
*.mp3  binary
*.pth  binary
*.onnx binary
*.safetensors binary
